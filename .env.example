# Redis connection URL (used by backend)
REDIS_URL=redis://redis:6379/0

# Cache TTL in seconds
CACHE_TTL_SECONDS=60

# Allowed CORS origins for the backend (comma-separated)
# Set to your public domain when deploying to EC2
CORS_ORIGINS=https://yourdomain.com

# Your public domain — used by nginx to locate the Let's Encrypt cert
DOMAIN=yourdomain.com

# Backend API URL for the frontend (Vite build-time env var).
# /api is a relative path — nginx proxies it to the backend container.
# For local dev (npm run dev) set this to http://localhost:<backend-port>/api in frontend/.env
VITE_API_BASE_URL=/api
